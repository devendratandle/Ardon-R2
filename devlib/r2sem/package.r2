# r2sem — PLS-SEM (composite path modelling) as a pure-R2 library.
# No engine edits: this is R2 source, installed with library("r2sem").
package_name        <- "r2sem"
package_version     <- "0.1.0"
package_description <- "Partial Least Squares path modelling (PLS-SEM) in pure R2."
package_author      <- "R2 community"
package_license     <- "AGPL-3.0"
package_exports     <- c("plssem")
