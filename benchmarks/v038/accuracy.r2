# FIXED deterministic input — measures COMPUTATION accuracy, not RNG.
x <- c(2.1,4.7,1.3,8.9,5.5,3.2,7.8,6.4,0.9,9.1,3.3,5.6,7.2,1.8,4.4,6.9,2.5,8.1,0.4,9.6)
y <- c(1.0,3.5,2.2,7.1,4.9,2.8,6.6,5.9,1.4,8.3,2.9,4.1,6.0,2.0,3.8,6.2,2.1,7.5,1.1,8.8)
p <- function(v) format(v, digits=17)
cat("mean=", p(mean(x)), "\n", sep="")
cat("sd=", p(sd(x)), "\n", sep="")
cat("var=", p(var(x)), "\n", sep="")
cat("median=", p(median(x)), "\n", sep="")
cat("cor=", p(cor(x,y)), "\n", sep="")
cat("cov=", p(cov(x,y)), "\n", sep="")
cat("sum=", p(sum(x)), "\n", sep="")
cat("prod=", p(prod(x[1:5])), "\n", sep="")
cat("q25=", p(quantile(x,0.25)[[1]]), "\n", sep="")
cat("q75=", p(quantile(x,0.75)[[1]]), "\n", sep="")
fit <- lm(y ~ x)
cat("lm.intercept=", p(coef(fit)[[1]]), "\n", sep="")
cat("lm.slope=", p(coef(fit)[[2]]), "\n", sep="")
cat("lm.r2=", p(summary(fit)$r.squared), "\n", sep="")
cat("exp1=", p(exp(1)), "\n", sep="")
cat("sqrt2=", p(sqrt(2)), "\n", sep="")
cat("log10=", p(log(10)), "\n", sep="")
cat("pnorm196=", p(pnorm(1.96)), "\n", sep="")
cat("qnorm975=", p(qnorm(0.975)), "\n", sep="")
cat("sin1=", p(sin(1)), "\n", sep="")
